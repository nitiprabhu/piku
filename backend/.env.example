# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string-here
FRONTEND_URL=http://localhost:3000

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql+asyncpg://reelcraft:password@postgres:5432/reelcraft
SYNC_DATABASE_URL=postgresql://reelcraft:password@postgres:5432/reelcraft
REDIS_URL=redis://redis:6379/0

# AI APIs
OPENAI_API_KEY=sk-...
# Sarvam AI — native Kannada/Indic TTS. Get key at https://dashboard.sarvam.ai
# Required for Kannada voice (kavya_f / vikram_m). Falls back to OpenAI tts-1-hd if blank.
SARVAM_API_KEY=

# Video generation provider: muapi | kling | falai
# Only the active provider's key needs to be set. Others can stay blank.
VIDEO_PROVIDER=muapi
MUAPI_API_KEY=
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=
FALAI_API_KEY=

# Cloudflare R2 (leave blank to use local /static fallback in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reelcraft-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Social OAuth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay recurring plan IDs for Pro/Business subscriptions.
# Create in Razorpay dashboard: Products → Plans → Create Plan (monthly, INR).
# Leave blank to use one-time order flow (no monthly renewal).
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_BUSINESS=

# SMS/OTP via MSG91 (leave blank in dev — OTP logged to console)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RCRAFT
